# Variables de entorno opcionales. Node no lee este archivo automáticamente:
#   local:  ADMIN_PIN=5678 npm start      (o: node --env-file=.env server.js)
#   Render: definirlas en Environment.
PORT=3000
# PIN para /admin y para reconfigurar tableros que ya tienen marcador
ADMIN_PIN=1234
# Carpeta donde se guarda scores.json (en Render, un disco persistente, p. ej. /var/data)
# DATA_DIR=./data
