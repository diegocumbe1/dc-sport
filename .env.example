# Variables de entorno opcionales. Node no lee este archivo automáticamente:
#   local:  ADMIN_PIN=5678 npm start      (o: node --env-file=.env server.js)
#   Render: definirlas en Environment.
PORT=3000
# PIN para /admin y para reconfigurar tableros que ya tienen marcador
ADMIN_PIN=1234
# Client ID de la app de Spotify (developer.spotify.com) para la música dentro del control.
# Redirect URI a registrar en Spotify: https://TU-DOMINIO/spotify
# SPOTIFY_CLIENT_ID=
# Carpeta donde se guarda scores.json (en Render, un disco persistente, p. ej. /var/data)
# DATA_DIR=./data
# Dirección pública de la plataforma de torneos. Con ella, el botón «Siguiente partido →» del juez
# le pide a la plataforma cargar el próximo partido en la misma sala de la cancha.
# PLATAFORMA_URL=https://play-mundial.uselynko.com
